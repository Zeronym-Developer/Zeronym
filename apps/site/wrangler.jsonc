{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zeronym-site",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "account_id": "<your-cloudflare-account-id>",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*", "/llms.txt", "/docs/verify/"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "zeronym-waitlist", "database_id": "<your-d1-database-id>", "migrations_dir": "migrations" }
  ],
  "ratelimits": [
    { "name": "WAITLIST_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "RELAY_LIMIT", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }
  ],
  "observability": { "enabled": false }
}
